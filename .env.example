# Base URL of the LancerFit backend. Must end in /api — every backend route
# is mounted under that prefix, so omitting it 404s even the login request.
# The Socket.IO origin is derived from this value by stripping /api, so this
# one variable configures both REST and realtime.
VITE_API_PATH=http://localhost:8000/api

# Optional background video on the login screen. Any direct video URL works;
# leave blank for a plain background.
VITE_LOGIN_VIDEO_URL=

# Note: only VITE_-prefixed variables reach client code, and everything so
# prefixed ships in the browser bundle. Never put a secret in this file.
# VITE_API_PATH is baked in at build time — a different API means a rebuild.